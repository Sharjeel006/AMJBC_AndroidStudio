<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingVertical="24dp">

            <!-- Top Row: Date and Hijri Date -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_date_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:id="@+id/tv_dates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="SEPTEMBER 17, 2026" />
                    <TextView
                        android:id="@+id/tv_hijri_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="16sp"
                        tools:text="6 Rabi' II 1448" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/today"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_refresh_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_dark" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Main Content Area: Next Prayer and Sun Section Side-by-Side -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_next_prayer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toStartOf="@+id/guideline_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_date_header">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">
                    <TextView
                        android:id="@+id/tv_next_prayer_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPCOMING PRAYER"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/tv_next_prayer_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Dhuhr"
                        android:textColor="@color/text_white"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_next_prayer_label" />
                    <TextView
                        android:id="@+id/tv_next_prayer_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:30 PM"
                        android:textColor="@color/text_white"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/tv_next_prayer_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_next_prayer_name" />
                    <ProgressBar
                        android:id="@+id/pb_prayer_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="20dp"
                        android:progress="45"
                        android:progressDrawable="@android:drawable/progress_horizontal"
                        android:progressTint="@color/white"
                        app:layout_constraintTop_toBottomOf="@id/tv_next_prayer_name" />
                    <TextView
                        android:id="@+id/tv_next_prayer_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="in 4h 23m"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/pb_prayer_progress" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <!-- Sun Section on the right for Tablet -->
            <LinearLayout
                android:id="@+id/sun_section"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="12dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@+id/cv_next_prayer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guideline_vertical"
                app:layout_constraintTop_toBottomOf="@id/cl_date_header">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="20dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_gradient_sunrise">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SUNRISE"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"/>
                        <TextView
                            android:id="@+id/sunriseTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:--"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Location Info (Hidden or moved in tablet to avoid clutter, but keeping tv_location for code) -->
                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="20dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_gradient_sunset">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SUNSET"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"/>
                        <TextView
                            android:id="@+id/sunsetTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:--"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Jumu'ah Section (Full Width) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_jumuah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/cv_next_prayer">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="32dp"
                    android:background="@drawable/bg_gradient_jumuah">
                    <ImageView
                        android:id="@+id/juma_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_mosque"
                        android:tint="#0C3E57"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/juma_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Jumu'ah Prayer"
                        android:textColor="#0C3E57"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/juma_icon"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/juma_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friday congregation"
                        android:textColor="#608090"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="@id/juma_title"
                        app:layout_constraintTop_toBottomOf="@id/juma_title" />

                    <LinearLayout
                        android:id="@+id/jumuah_reminder_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/jumatimeid"
                        app:layout_constraintStart_toEndOf="@+id/juma_title"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_bias="0.5">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_alarm_outline"
                            android:tint="#800C3E57"
                            tools:ignore="UseAppTint" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/jumuah_reminder_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-6dp"
                            android:scaleX="0.8"
                            android:scaleY="0.8" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-8dp"
                            android:text="1 hour"
                            android:textColor="#800C3E57"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/jumatimeid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:00 PM"
                        android:textColor="#0C3E57"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Prayer Times Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_list_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/cv_jumuah">
                <ImageView
                    android:id="@+id/btn_prev_day"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_previous"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/text_dark" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintStart_toEndOf="@id/btn_prev_day"
                    app:layout_constraintEnd_toStartOf="@id/btn_next_day"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prayer times"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <TextView
                        android:id="@+id/tv_masjid_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Baitur-Rehman &amp; Baitul-Hamd"
                        android:textColor="@color/text_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/btn_next_day"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_next"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/text_dark" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_prayer_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/cl_list_header">
                <ListView
                    android:id="@+id/listview1"
                    android:layout_width="match_parent"
                    android:layout_height="450dp"
                    android:divider="#20000000"
                    android:dividerHeight="1dp"
                    android:padding="12dp"
                    android:nestedScrollingEnabled="true"
                    tools:listitem="@layout/listview_item" />
            </androidx.cardview.widget.CardView>

            <!-- Ramadan Button (Hidden by default) -->
            <Button
                android:id="@+id/ramazangoto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Go to Ramadan Schedule"
                android:textAllCaps="false"
                android:textColor="#EAB308"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingHorizontal="32dp"
                android:paddingVertical="16dp"
                android:visibility="gone"
                app:strokeColor="#EAB308"
                app:strokeWidth="2dp"
                app:cornerRadius="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cv_prayer_list" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
