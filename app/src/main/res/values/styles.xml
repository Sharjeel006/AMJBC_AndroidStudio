<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->
    <style name="AppBaseTheme" parent="android:Theme.Light">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->

        <item name="android:statusBarColor">@color/design_default_color_primary</item>
        <item name="android:navigationBarColor">@color/design_default_color_primary</item>
        <item name="android:windowLightStatusBar">false</item> <!-- makes icons white -->
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>




    <!-- Application theme. -->
    <style name="AppTheme" parent="android:style/Theme.Holo.Light">

        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
    </style>
    <style name="AppTheme2" parent="Theme.AppCompat"></style>


    <!-- the theme applied to the application or activity -->
    <style name="CustomActionBarTheme"
           parent="@android:style/Theme.Holo">
     <item name="android:windowActionBarOverlay">false</item>      
     
     </style>
       
    
    
    
</resources>
