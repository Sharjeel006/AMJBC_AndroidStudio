<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.local.amjbc"
    android:versionCode="202"
    android:versionName="20.2" >

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="36" />

    <!-- Essential Permissions Needed for Core App Functionality -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Required by older versions of Google Play services to create IID tokens -->
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />

    <permission
        android:name="com.local.amjbc.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.local.amjbc.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.local.amjbc.Application"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_islam_4"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/AppTheme2"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.local.amjbc.MainActivity2"
            android:exported="true"
            android:theme="@style/AppTheme" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <activity android:name="com.local.amjbc.chandacal.DetailActivity" />
        <activity
            android:name="com.local.amjbc.Splash"
            android:exported="true"
            android:label="@string/title_activity_splash"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar" />

        <receiver
            android:name="com.local.amjbc.NotificationPublisher"
            android:exported="false" />

        <service
            android:name="com.local.amjbc.MyFirebaseMessagingService"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service android:name="com.local.amjbc.chandacal.SyncService" />

        <receiver
            android:name="com.local.amjbc.PrayerReminderReceiver"
            android:exported="false" />
    </application>

</manifest>